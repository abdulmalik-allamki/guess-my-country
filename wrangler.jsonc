{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guess-my-country",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // LOAD-BEARING. Without run_worker_first the asset server answers before the
  // Worker and the security headers in src/index.js never ship.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // One Durable Object per room, addressed by room code (src/room.js).
  // SQLite-backed is the only kind the Workers free plan allows.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
